# Copy this file to .env for local development. Never commit .env.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Matches the db service in docker-compose.yml (start it with: docker compose up -d db).
# Docker Compose sets its own value for the containers, so this one is for npm run dev.
DATABASE_URL=postgres://kursi:kursi@localhost:5432/kursi

# Make a real one with: node -e "console.log(crypto.randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# `docker compose up` adds the demo accounts and events after migrating; false skips them.
# Anywhere else they are added only when this is true. Never on a real deployment: the demo
# accounts' password is public.
# SEED_DEMO_DATA=false

# Leave unset locally. Behind a reverse proxy or load balancer, set it to match that setup
# (for example 1 for one proxy hop), or rate limits will key on the wrong IP. See docs/deployment.md.
# TRUST_PROXY=1
